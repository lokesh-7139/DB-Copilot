OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Local SQL Server Express using Windows Authentication and shared memory.
DATABASE_URL='mssql+pyodbc://@lpc:.\SQLEXPRESS/DBCopilot?driver=ODBC+Driver+18+for+SQL+Server&Trusted_Connection=yes&Encrypt=yes&TrustServerCertificate=yes'
DB_SCHEMA=dbo
MSSQL_READONLY_USER=copilot_reader
# Optional comma-separated allowlist; blank exposes all visible tables in DB_SCHEMA.
ALLOWED_TABLES=
MAX_ROWS=200
QUERY_TIMEOUT_MS=5000
EMBEDDING_MODEL=text-embedding-3-small
SCHEMA_TOP_K=3
# TrustServerCertificate=yes is for the local self-signed development instance only.
